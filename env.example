# Local development only. Copy to .env and replace this key.
SECRET_KEY=replace-with-a-random-local-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Optional for Python running directly on your computer. If omitted, uses SQLite.
# DATABASE_URL=postgresql://tasks:password@localhost:5432/tasks

# Optional Docker Compose overrides. Compose constructs DATABASE_URL using these.
POSTGRES_DB=tasks
POSTGRES_USER=tasks
POSTGRES_PASSWORD=local-development-only
